FROM rust:1.82-slim AS builder

WORKDIR /app

# Install build dependencies for Polars (OpenSSL, etc.)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN cargo build --release -p backtest-api

# ── Runtime ────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/backtest-api /usr/local/bin/backtest-api

ENV NATS_URL=nats://nats:4222
ENV DATA_DIR=/data

CMD ["backtest-api"]
