# ─────────────────────────────────────────────────────────────────────────────
# Herald — single binary that hosts:
#   • JetStream consumer for bars → ledger → signals
#   • HTTP API for live data + indicators + backtests (port 8090)
#
# Replaces the old signal-engine / backtest-api / logbook trio: the ledger
# lives in-process, so splitting into 3 containers only added serialisation
# cost and forked state. One image, one workload.
# ─────────────────────────────────────────────────────────────────────────────

FROM rust:1.90-slim AS builder

RUN apt-get update && apt-get install -y \
        pkg-config \
        libssl-dev \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# `alm-core`'s build.rs expects `proto/` one level above the almanac crate
# root. In repo it's `mallow/proto`; in docker we mount that via buildx
# `additional_contexts: proto=../proto` and drop it at `/proto` so the
# path invariant holds. See `almanac/crates/core/build.rs`.
COPY --from=proto . /proto

WORKDIR /app
COPY . .

RUN cargo build --release -p herald

# ─────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
        ca-certificates \
        libssl3 \
        wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/herald /usr/local/bin/herald

ENV NATS_URL=nats://nats:4222
ENV HERALD_HTTP_ADDR=0.0.0.0:8090
ENV HERALD_DATA_DIR=/data
ENV RUST_LOG=herald=info,alm_ledger=info

EXPOSE 8090

CMD ["herald"]
