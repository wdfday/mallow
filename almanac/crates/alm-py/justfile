default:
    @just --list

# Initialize virtual environment using python3 (prefers python3.13 or 3.12)
init:
    @if command -v python3.13 >/dev/null 2>&1; then \
        python3.13 -m venv .venv; \
        echo "Created virtual environment using Python 3.13"; \
    elif command -v python3.12 >/dev/null 2>&1; then \
        python3.12 -m venv .venv; \
        echo "Created virtual environment using Python 3.12"; \
    else \
        python3 -m venv .venv; \
        echo "Created virtual environment using default python3"; \
    fi

# Build and install alm-py in debug/develop mode into the local virtual environment
build:
    .venv/bin/maturin develop

# Build and install alm-py in release/develop mode (faster execution)
build-release:
    .venv/bin/maturin develop --release

# Install all required Python dependencies into the local virtual environment
install-deps:
    .venv/bin/pip install --upgrade pip
    .venv/bin/pip install maturin
    .venv/bin/pip install -e .[dev]

# Run all python tests in alm-py
test:
    .venv/bin/pytest tests/

# Run a specific python test file or case (e.g. `just test-file tests/test_backtest.py`)
test-file file_path:
    .venv/bin/pytest {{file_path}} -v

# Run the end-to-end strategy comparison pipeline (automatically builds in release mode)
compare: build-release
    cd notebooks/comparison && ../../.venv/bin/python run_pipeline.py

# Clear generated comparison notebooks and python caches
clear:
    rm -f notebooks/comparison/cmp_*.ipynb
    rm -rf .pytest_cache
    find . -type d -name "__pycache__" -exec rm -rf {} +
    @echo "Cleared generated comparison notebooks and python caches."
