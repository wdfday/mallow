dc := "docker compose -f ../deployment/docker-compose.yml"

# List all recipes
default:
    @just --list

# ── Build ─────────────────────────────────────────────────────────────────────

# Build entire workspace
build:
    cargo build

# Build in release mode
build-release:
    cargo build --release

# ── Test ──────────────────────────────────────────────────────────────────────

# Run all tests
test:
    cargo test

# Run tests for a specific crate (e.g. just test-crate alm-strategy)
test-crate crate:
    cargo test -p {{crate}}

# Run tests matching a name filter
test-name name:
    cargo test {{name}}

# ── Run ───────────────────────────────────────────────────────────────────────

# Run herald (live signal engine + HTTP API)
run:
    cargo run -p alm-herald

# Run herald with debug logging
run-debug:
    RUST_LOG=alm_herald=debug,alm_ledger=debug cargo run -p alm-herald

# Hot-reload herald on file changes (requires cargo-watch)
dev:
    cargo watch -x 'run -p alm-herald'

# ── Code quality ──────────────────────────────────────────────────────────────

# Lint with clippy (treat warnings as errors)
lint:
    cargo clippy -- -D warnings

# Format all source files
fmt:
    cargo fmt

# Check formatting without modifying files
fmt-check:
    cargo fmt --check

# ── Docker ────────────────────────────────────────────────────────────────────

# Build + start herald container
up:
    {{dc}} up -d --build herald

# Start herald without rebuild
start:
    {{dc}} up -d herald

# Stop all containers
down:
    {{dc}} down

# Tail herald logs
logs:
    {{dc}} logs -f herald

# Restart herald
restart:
    {{dc}} restart herald

# ── Utilities ─────────────────────────────────────────────────────────────────

# Remove build artifacts
clean:
    cargo clean

# Show dependency tree
deps:
    cargo tree

# Check for outdated dependencies
outdated:
    cargo outdated
