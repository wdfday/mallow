dc := "docker compose -f ../deployment/docker-compose.yml"

# List all recipes
default:
    @just --list

# ── Build ─────────────────────────────────────────────────────────────────────

# Build entire workspace
build:
    cargo build

# Build in release mode
build-release:
    cargo build --release

# ── Test ──────────────────────────────────────────────────────────────────────

# Run all tests
test:
    cargo test

# Run tests for a specific crate (e.g. just test-crate alm-strategy)
test-crate crate:
    cargo test -p {{crate}}

# Run tests matching a name filter
test-name name:
    cargo test {{name}}

# ── Run ───────────────────────────────────────────────────────────────────────

# Run herald locally — reads deployment/symbols.yaml + ../data/
run:
    NATS_URL="nats://signal_engine:signal-engine-dev@localhost:4222" \
    HERALD_HTTP_ADDR="0.0.0.0:8090" \
    HERALD_DATA_DIR="../data" \
    HERALD_SYMBOLS_FILE="../deployment/symbols.yaml" \
    HERALD_WARM_DAYS=5 \
    HERALD_MAX_BACKTESTS=4 \
    RUST_LOG="alm_herald=debug,alm_ledger=info,alm_engine=debug" \
    cargo run --bin alm-herald

# Run herald with debug logging
run-debug:
    NATS_URL="nats://signal_engine:signal-engine-dev@localhost:4222" \
    HERALD_HTTP_ADDR="0.0.0.0:8090" \
    HERALD_DATA_DIR="../data" \
    HERALD_SYMBOLS_FILE="../deployment/symbols.yaml" \
    HERALD_WARM_DAYS=5 \
    RUST_LOG="alm_herald=debug,alm_ledger=info,alm_engine=debug" \
    cargo run --bin alm-herald

# Run herald with release optimisations (faster backtest, same symbols)
run-release:
    NATS_URL="nats://signal_engine:signal-engine-dev@localhost:4222" \
    HERALD_HTTP_ADDR="0.0.0.0:8090" \
    HERALD_DATA_DIR="../data" \
    HERALD_SYMBOLS_FILE="../deployment/symbols.yaml" \
    HERALD_WARM_DAYS=5 \
    HERALD_MAX_BACKTESTS=4 \
    RUST_LOG="alm_herald=info,alm_ledger=info" \
    cargo run --bin alm-herald --release

# Hot-reload herald on file changes (requires cargo-watch)
dev:
    NATS_URL="nats://signal_engine:signal-engine-dev@localhost:4222" \
    HERALD_HTTP_ADDR="0.0.0.0:8090" \
    HERALD_DATA_DIR="../data" \
    HERALD_SYMBOLS_FILE="../deployment/symbols.yaml" \
    HERALD_WARM_DAYS=2 \
    RUST_LOG="alm_herald=debug,alm_ledger=info" \
    cargo watch -x 'run --bin alm-herald'

# ── Code quality ──────────────────────────────────────────────────────────────

# Lint with clippy (treat warnings as errors)
lint:
    cargo clippy -- -D warnings

# Format all source files
fmt:
    cargo fmt

# Check formatting without modifying files
fmt-check:
    cargo fmt --check

# ── Docker ────────────────────────────────────────────────────────────────────

# Build + start herald container
up:
    {{dc}} up -d --build herald

# Start herald without rebuild
start:
    {{dc}} up -d herald

# Stop all containers
down:
    {{dc}} down

# Tail herald logs
logs:
    {{dc}} logs -f herald

# Restart herald
restart:
    {{dc}} restart herald

# ── OpenAPI ───────────────────────────────────────────────────────────────────

# Export OpenAPI spec as YAML (default) or JSON: just gen-openapi [json]
gen-openapi format="yaml":
    cargo run --bin gen-openapi -- {{format}} > openapi.{{format}}
    @echo "wrote openapi.{{format}}"

# ── Benchmarks ────────────────────────────────────────────────────────────────

# Full alm-strategy Rhai-vs-hardcoded benchmark (same command CI runs on push to main)
bench:
    cargo bench -p alm-strategy --bench expr

# Quick low-sample run for local iteration — not for tracking/CI, just a fast
# directional read while poking at the engine. Pass a filter to scope to one
# group, e.g. `just bench-quick rsi_run`.
bench-quick filter="":
    cargo bench -p alm-strategy --bench expr -- {{filter}} --warm-up-time 1 --measurement-time 2 --sample-size 10

# ── Utilities ─────────────────────────────────────────────────────────────────

# Remove build artifacts
clean:
    cargo clean

# Show dependency tree
deps:
    cargo tree

# Check for outdated dependencies
outdated:
    cargo outdated

# Clear generated notebooks and python caches in alm-py
clear:
    rm -f crates/alm-py/notebooks/comparison/cmp_*.ipynb
    rm -rf crates/alm-py/.pytest_cache
    find . -type d -name "__pycache__" -exec rm -rf {} +
    @echo "Cleared generated comparison notebooks and python caches."
