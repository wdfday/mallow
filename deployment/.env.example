# =============================================================================
# Mallow Trading System — Environment Variables
# cp deployment/.env.example deployment/.env && fill in values
# =============================================================================

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
ENCRYPTION_KEY=01234567890123456789012345678901
POSTGRES_PASSWORD=mallow-dev
SERVICE_SECRET=change-me-inter-service-secret

# ── NATS passwords (one per service) ─────────────────────────────────────────
NATS_PASS_SIGNAL_ENGINE=signal-engine-dev
NATS_PASS_HELM=helm-dev
NATS_PASS_INVESTMENT=investment-dev
NATS_PASS_STRATEGIST=strategist-dev
NATS_PASS_GATEWAY=gateway-dev
NATS_PASS_IDENTITY=identity-dev
NATS_PASS_SURVEYOR=surveyor-dev

# ── Telegram Bots ─────────────────────────────────────────────────────────────
# Bot 1 — General (identity service): /start, /link, /help
TELEGRAM_GENERAL_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_CHATS= # comma-separated chat IDs, empty = allow all

# Bot 2 — Strategist (strategist service): AI chat + trading ops
TELEGRAM_BOT_TOKEN=

# ── Exchange API Keys ─────────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini # gemini | claude | openai
# LLM_MODEL=                   # override default model per provider
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Herald (signal engine + backtest API) ─────────────────────────────────────
HERALD_MAX_BACKTESTS=4
HERALD_RUST_LOG=herald=info,alm_ledger=info
# HERALD_DATABASE_URL=postgres://mallow:${POSTGRES_PASSWORD}@postgres:5432/herald?sslmode=disable

# ── Orchestrator ──────────────────────────────────────────────────────────────
SYNC_INTERVAL=5m
INITIAL_CAPITAL=100000

# ── App config ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
GIN_MODE=release
LOG_LEVEL=info
LOG_ENV=production

# ── Monitoring (--profile monitoring) ────────────────────────────────────────
GRAFANA_PASSWORD=mallow
LOKI_S3_BUCKET=
LOKI_S3_BUCKET_REGION=
LOKI_S3_ACCESS_KEY=
LOKI_S3_SECRET_KEY=
LOKI_S3_ENDPOINT=

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT= # e.g. http://tempo:4317

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
CLOUDFLARED_TUNNEL_TOKEN=
