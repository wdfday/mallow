# =============================================================================
# Thesis Trading System — Environment Variables
# cp deployment/.env.example .env && fill in values
# =============================================================================

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
ENCRYPTION_KEY=01234567890123456789012345678901
POSTGRES_PASSWORD=thesis-dev
SERVICE_SECRET=change-me-inter-service-secret

# ── Telegram Bots ─────────────────────────────────────────────────────────────
# Bot 1 — General (identity): /start, /link, /help — no auth required
TELEGRAM_GENERAL_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=        # comma-separated chat IDs, empty = allow all

# Bot 2 — Strategist (strategist): AI chat + trading ops, requires linked account
STRATEGIST_BOT_TOKEN=

# Bot 3 — Signal/Approval (orchestrator): push signals with Execute/Skip keyboard
SIGNAL_BOT_TOKEN=
SIGNAL_BOT_ALLOWED_CHATS=     # comma-separated operator chat IDs
SIGNAL_BOT_TIMEOUT=5m          # auto-expire if no response

# ── Exchange API Keys ─────────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=

BINANCE_API_KEY=
BINANCE_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

TWELVEDATA_API_KEY=

# ── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini          # gemini | anthropic | openai
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── App config ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
GIN_MODE=release
LOG_LEVEL=info
LOG_ENV=production
