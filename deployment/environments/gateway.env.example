# =============================================================================
# API Gateway — local dev config
# Gateway không tự load .env — inject thủ công qua shell hoặc justfile.
# Setup:
#   cp deployment/environments/gateway.env.example deployment/environments/gateway.env
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
RATE_LIMIT_PER_MINUTE=500

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-super-secret-change-in-production
SERVICE_SECRET=dev-service-secret

# ── Infra ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://gateway:gateway-dev@localhost:4222
REDIS_URL=redis://localhost:6379

# ── Upstream service URLs (local) ─────────────────────────────────────────────
IDENTITY_URL=http://localhost:8082
HELM_URL=http://localhost:8084
HERALD_URL=http://localhost:8090

# ── App ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
GIN_MODE=debug
