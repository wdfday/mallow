# =============================================================================
# Helm Service — local dev config
# Setup:
#   cp deployment/environments/helm.env.example deployment/environments/helm.env
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
API_ADDR=localhost:8084

# ── Database (local) ──────────────────────────────────────────────────────────
NATS_URL=nats://helm:helm-dev@localhost:4222
POSTGRES_URL=postgres://mallow:mallow-dev@localhost:5432/helm?sslmode=disable

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=01234567890123456789012345678901

# ── Runtime ───────────────────────────────────────────────────────────────────
SYNC_INTERVAL=5m

# ── Profiling (optional) ──────────────────────────────────────────────────────
PYROSCOPE_URL=http://localhost:4040
