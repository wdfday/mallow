# =============================================================================
# Herald (Rust) — local dev config
# Herald không tự load .env — inject thủ công qua shell hoặc justfile.
# Setup:
#   cp deployment/environments/herald.env.example deployment/environments/herald.env
# =============================================================================

# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_URL=nats://signal_engine:signal-engine-dev@localhost:4222

# ── Database (optional — để trống thì dùng in-memory store) ──────────────────
HERALD_DATABASE_URL=postgres://mallow:mallow-dev@localhost:5432/herald?sslmode=disable

# ── HTTP ──────────────────────────────────────────────────────────────────────
HERALD_HTTP_ADDR=0.0.0.0:8090

# ── Data & Symbols ────────────────────────────────────────────────────────────
# HERALD_DATA_DIR được set động bởi justfile (dùng justfile_directory())
HERALD_SYMBOLS_FILE=deployment/symbols.yaml

# ── Tuning ────────────────────────────────────────────────────────────────────
HERALD_WARM_BARS=500
HERALD_MAX_BACKTESTS=4

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=alm_herald=info,alm_ledger=info
RUST_BACKTRACE=1
