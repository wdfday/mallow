# =============================================================================
# Identity Service — local dev config
# Setup:
#   cp deployment/environments/identity.env.example deployment/environments/identity.env
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8082
GIN_MODE=debug

# ── Database (local — trỏ tới infra chạy bởi just infra) ────────────────────
POSTGRES_URL=postgres://mallow:mallow-dev@localhost:5432/identity?sslmode=disable
NATS_URL=nats://identity:identity-dev@localhost:4222

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-super-secret-change-in-production
JWT_KEY_ID=identity-ed25519-local-dev
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIPX6I43U7CbpwL8AcN3I0FsnnxAnm3wieY/KguDuYqk1\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAmYGwA4BhM2kAQ08jRA/uc1U7Pv5Jr4a5hCH1D1q+QoQ=\n-----END PUBLIC KEY-----
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h

# ── Cookies ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://forge.m4llow.com/

# ── Google OAuth ──────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID: "Web application" OAuth client (mallow-client's implicit flow).
# GOOGLE_CLIENT_ID_DESKTOP: separate "Desktop app" OAuth client for native apps using
# loopback-redirect Authorization Code + PKCE (e.g. fathom-tde). Both audiences are accepted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_DESKTOP=

# ── Encryption (AES-256 — exactly 32 ASCII chars) ─────────────────────────────
ENCRYPTION_KEY=secret

# ── Internal service-to-service auth ─────────────────────────────────────────
SERVICE_SECRET=dev-service-secret

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Identity Service

# ── Mail worker ───────────────────────────────────────────────────────────────
MAIL_NATS_SUBJECT=mail.send
MAIL_WORKER_CONCURRENCY=3
MAIL_WORKER_BUFFER=100

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_GENERAL_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_CHATS=

# ── Admin seed ────────────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=Admin@123456
