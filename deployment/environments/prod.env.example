# =============================================================================
# Mallow Trading System — Production Environment Variables
#
# This file is a TEMPLATE ONLY. The real prod.env must never be committed —
# not even accidentally. In practice, prefer injecting these as real secrets
# via your deploy platform/secret manager rather than keeping a prod.env file
# sitting on disk at all; this file exists mainly to document which keys exist
# and to diff against for "did I forget to set something" before a deploy.
#
# Every value below must be distinct from both dev's and staging's — a leaked
# staging secret should never be a path into prod.
# =============================================================================

# ── Secrets (generate fresh, store in a secret manager — not this file) ──────
JWT_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
SERVICE_SECRET=

# ── NATS passwords (one per service, prod-only) ──────────────────────────────
NATS_PASS_SIGNAL_ENGINE=
NATS_PASS_HELM=
NATS_PASS_GATEWAY=
NATS_PASS_IDENTITY=
NATS_PASS_SURVEYOR=

# ── Telegram Bots (the real production bot) ──────────────────────────────────
TELEGRAM_GENERAL_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_BOT_TOKEN=

# ── Exchange API Keys (live keys — highest blast radius in this whole file) ──
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://api.alpaca.markets

# ── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── App config ────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://forge.m4llow.com
GIN_MODE=release
LOG_LEVEL=info
LOG_ENV=production

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=
PYROSCOPE_URL=http://pyroscope:4040
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Loki S3 ───────────────────────────────────────────────────────────────────
LOKI_S3_BUCKET=
LOKI_S3_BUCKET_REGION=
LOKI_S3_ACCESS_KEY=
LOKI_S3_SECRET_KEY=
LOKI_S3_ENDPOINT=

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
CLOUDFLARED_TUNNEL_TOKEN=
