# =============================================================================
# Mallow Trading System — Shared Environment Variables
# Dùng chung cho docker-compose và tất cả service khi chạy local.
#
# Setup:
#   cp deployment/environments/shared.env.example deployment/environments/shared.env
#   # rồi điền các giá trị thật vào
# =============================================================================

# ── Secrets ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
ENCRYPTION_KEY=01234567890123456789012345678901
POSTGRES_PASSWORD=mallow-dev
SERVICE_SECRET=change-me-inter-service-secret

# ── NATS passwords (one per service) ─────────────────────────────────────────
NATS_PASS_SIGNAL_ENGINE=signal-engine-dev
NATS_PASS_HELM=helm-dev
NATS_PASS_INVESTMENT=investment-dev
NATS_PASS_STRATEGIST=strategist-dev
NATS_PASS_GATEWAY=gateway-dev
NATS_PASS_IDENTITY=identity-dev
NATS_PASS_SURVEYOR=surveyor-dev

# ── Telegram Bots ─────────────────────────────────────────────────────────────
TELEGRAM_GENERAL_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_CHATS=

TELEGRAM_BOT_TOKEN=

# ── Exchange API Keys ─────────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── App config ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://forge.m4llow.com
GIN_MODE=release
LOG_LEVEL=info
LOG_ENV=production

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=mallow
PYROSCOPE_URL=http://pyroscope:4040
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Loki S3 ───────────────────────────────────────────────────────────────────
LOKI_S3_BUCKET=
LOKI_S3_BUCKET_REGION=
LOKI_S3_ACCESS_KEY=
LOKI_S3_SECRET_KEY=
LOKI_S3_ENDPOINT=

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
CLOUDFLARED_TUNNEL_TOKEN=
