# =============================================================================
# Mallow Trading System — Staging Environment Variables
#
# Same shape as shared.env.example, but every value here should be a real
# staging secret — never copy dev's values in, and never reuse these in prod.
# NATS_PASS_*, JWT_SECRET, ENCRYPTION_KEY, POSTGRES_PASSWORD, SERVICE_SECRET
# must all be freshly generated for this environment.
#
# Setup:
#   cp deployment/environments/staging.env.example deployment/environments/staging.env
#   # fill in real staging values, then:
#   docker compose --env-file deployment/environments/staging.env \
#     -f deployment/docker-compose.yml -f deployment/docker-compose.staging.yml \
#     --profile monitoring up -d
# =============================================================================

# ── Secrets (generate fresh — do not reuse dev or prod values) ────────────────
JWT_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
SERVICE_SECRET=

# ── NATS passwords (one per service, staging-only) ───────────────────────────
NATS_PASS_SIGNAL_ENGINE=
NATS_PASS_HELM=
NATS_PASS_GATEWAY=
NATS_PASS_IDENTITY=
NATS_PASS_SURVEYOR=

# ── Telegram Bots (use a separate staging bot, not the prod one) ─────────────
TELEGRAM_GENERAL_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_BOT_TOKEN=

# ── Exchange API Keys (paper/testnet keys only — never prod exchange keys) ───
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── AI / LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── App config ────────────────────────────────────────────────────────────────
# CORS_ORIGINS should point at staging's own domain, not dev's localhost or
# prod's domain — pick one so a stray dev/prod tab can't accidentally hit staging.
CORS_ORIGINS=
GIN_MODE=release
LOG_LEVEL=info
LOG_ENV=staging

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=
PYROSCOPE_URL=http://pyroscope:4040
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Loki S3 ───────────────────────────────────────────────────────────────────
LOKI_S3_BUCKET=
LOKI_S3_BUCKET_REGION=
LOKI_S3_ACCESS_KEY=
LOKI_S3_SECRET_KEY=
LOKI_S3_ENDPOINT=

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Use a separate tunnel token from prod if staging is publicly reachable at all —
# a shared tunnel means a staging outage/misconfig can take prod's domain down too.
CLOUDFLARED_TUNNEL_TOKEN=
