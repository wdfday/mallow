{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "API Gateway — WebSocket connections, HTTP routing, proxy latencies, auth, and rate-limiting",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "Overview", "type": "row" },

    { "type": "stat", "id": 1,
      "title": "Active WebSockets",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "gateway_ws_connections", "legendFormat": "active conns", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "stat", "id": 2,
      "title": "In-Flight HTTP",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 150 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "gateway_http_in_flight", "legendFormat": "in-flight", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "stat", "id": 3,
      "title": "HTTP Rate / min",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "reqpm", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [{ "expr": "sum(rate(gateway_http_requests_total[2m])) * 60", "legendFormat": "reqs/min", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "stat", "id": 4,
      "title": "Rate Limit Blocks (5m)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "color": { "mode": "thresholds" }, "unit": "short" } },
      "targets": [{ "expr": "increase(gateway_ratelimit_blocked_total[5m])", "legendFormat": "blocked (5m)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "stat", "id": 5,
      "title": "Proxy Errors (5m)",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "color": { "mode": "thresholds" }, "unit": "short" } },
      "targets": [{ "expr": "sum(increase(gateway_proxy_errors_total[5m])) or vector(0)", "legendFormat": "errors (5m)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "stat", "id": 6,
      "title": "Auth Rejections (5m)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 }] }, "color": { "mode": "thresholds" }, "unit": "short" } },
      "targets": [{ "expr": "sum(increase(gateway_auth_rejections_total[5m])) or vector(0)", "legendFormat": "rejections (5m)", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 101, "title": "HTTP Traffic & Performance", "type": "row" },

    { "type": "timeseries", "id": 10,
      "title": "HTTP Request Rate by Route (reqs/min)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by (route) (rate(gateway_http_requests_total[2m])) * 60", "legendFormat": "{{route}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "timeseries", "id": 11,
      "title": "HTTP Request Duration Avg (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "targets": [{ "expr": "sum by (route) (rate(gateway_http_request_duration_seconds_sum[2m])) / sum by (route) (rate(gateway_http_request_duration_seconds_count[2m]))", "legendFormat": "{{route}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "timeseries", "id": 12,
      "title": "HTTP Status Code Distribution",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by (status) (rate(gateway_http_requests_total[2m])) * 60", "legendFormat": "HTTP {{status}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "timeseries", "id": 13,
      "title": "Upstream Proxy Errors by Target",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 }, "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [{ "expr": "sum by (upstream) (rate(gateway_proxy_errors_total[2m])) * 60", "legendFormat": "proxy error: {{upstream}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "id": 102, "title": "WebSocket & Security Metrics", "type": "row" },

    { "type": "timeseries", "id": 20,
      "title": "Active WebSocket Connections Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 }, "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "targets": [{ "expr": "gateway_ws_connections", "legendFormat": "WebSocket conns", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "timeseries", "id": 21,
      "title": "WebSocket Frame Throughput by Channel Type (frames/min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by (direction) (rate(gateway_ws_frames_total[2m])) * 60", "legendFormat": "channel: {{direction}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "timeseries", "id": 22,
      "title": "Auth Rejections by Reason",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by (reason) (rate(gateway_auth_rejections_total[2m])) * 60", "legendFormat": "reason: {{reason}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "timeseries", "id": 23,
      "title": "Rate Limit Block Rate / min",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "reqpm", "custom": { "lineWidth": 2, "fillOpacity": 10 }, "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [{ "expr": "rate(gateway_ratelimit_blocked_total[2m]) * 60", "legendFormat": "blocks/min", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["gateway", "trading", "api-gateway"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "API Gateway Metrics",
  "uid": "api-gateway-metrics",
  "version": 1
}
