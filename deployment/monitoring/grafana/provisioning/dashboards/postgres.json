{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Postgres Database — connection pool, transaction rates, cache hit ratio, CRUD throughput, and disk size",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "Overview", "type": "row" },

    { "type": "stat", "id": 1,
      "title": "Postgres Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "pg_up", "legendFormat": "database status", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "stat", "id": 2,
      "title": "Active Backends (Conns)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 90 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sum(pg_stat_database_numbackends)", "legendFormat": "backends", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "stat", "id": 3,
      "title": "Cache Hit Ratio",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 95 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])) + 1) * 100", "legendFormat": "cache ratio", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "stat", "id": 4,
      "title": "Transactions Committed / sec",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "tps", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [{ "expr": "sum(rate(pg_stat_database_xact_commit[2m]))", "legendFormat": "commits/sec", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "stat", "id": 5,
      "title": "Transactions Rolled Back / sec",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "tps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sum(rate(pg_stat_database_xact_rollback[2m]))", "legendFormat": "rollbacks/sec", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "stat", "id": 6,
      "title": "Total Database Size",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "targets": [{ "expr": "sum(pg_database_size_bytes)", "legendFormat": "db size", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 101, "title": "Connection & Transaction Performance", "type": "row" },

    { "type": "timeseries", "id": 10,
      "title": "Active Backends per Database",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "pg_stat_database_numbackends{datname!=\"\"}", "legendFormat": "{{datname}}", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "timeseries", "id": 11,
      "title": "Transactions Throughput (commits & rollbacks)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "tps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_commit[2m]))", "legendFormat": "{{datname}} commits", "refId": "A" },
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback[2m]))", "legendFormat": "{{datname}} rollbacks", "refId": "B" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "id": 102, "title": "I/O Stats & Database Sizes", "type": "row" },

    { "type": "timeseries", "id": 20,
      "title": "Cache Hit Ratio per Database",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "lineWidth": 2 }, "max": 100 } },
      "targets": [{ "expr": "rate(pg_stat_database_blks_hit{datname!=\"\"}[5m]) / (rate(pg_stat_database_blks_hit{datname!=\"\"}[5m]) + rate(pg_stat_database_blks_read{datname!=\"\"}[5m]) + 1) * 100", "legendFormat": "{{datname}} Cache ratio", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "timeseries", "id": 21,
      "title": "Database Size Growth",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "pg_database_size_bytes{datname!=\"\"}", "legendFormat": "{{datname}} size", "refId": "A" }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "id": 103, "title": "Row CRUD Operations", "type": "row" },

    { "type": "timeseries", "id": 30,
      "title": "Read Query Activity (Rows fetched/returned)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_tup_returned[2m]))", "legendFormat": "Rows returned (scan)", "refId": "A" },
        { "expr": "sum(rate(pg_stat_database_tup_fetched[2m]))", "legendFormat": "Rows fetched (select)", "refId": "B" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    { "type": "timeseries", "id": 31,
      "title": "Write Query Activity (Rows inserted/updated/deleted)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_tup_inserted[2m]))", "legendFormat": "Inserted rows", "refId": "A" },
        { "expr": "sum(rate(pg_stat_database_tup_updated[2m]))", "legendFormat": "Updated rows", "refId": "B" },
        { "expr": "sum(rate(pg_stat_database_tup_deleted[2m]))", "legendFormat": "Deleted rows", "refId": "C" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["postgres", "trading", "infrastructure"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Postgres Database Metrics",
  "uid": "postgres-database-metrics",
  "version": 1
}
