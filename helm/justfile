dc := "docker compose -f ../deployment/docker-compose.yml"

# List all recipes
default:
    @just --list

# ── Local dev ─────────────────────────────────────────────────────────────────

# Build binary
build:
    go build -o bin/helm ./cmd/helm/

# Run locally
run:
    go run ./cmd/helm/

# Hot-reload with air
dev:
    ~/.go/bin/air

# Run unit tests — one package at a time, sequential within each package, 512 MiB heap cap.
# -p 1        : only one package compiled+tested at a time (biggest lever against OOM)
# -parallel 1 : no concurrent t.Parallel() within a package
# -short      : skip tests that call t.Skip() under testing.Short()
# GOMEMLIMIT  : hard GC target; Go will GC aggressively before hitting this limit
test:
    GOMEMLIMIT=512MiB go test -p 1 -parallel 1 -count=1 -short ./...

# Fast module-only tests (excludes the heavier runtime integration package)
test-unit:
    GOMEMLIMIT=512MiB go test -p 1 -parallel 1 -count=1 -short \
        ./internal/runtime/core/... \
        ./internal/module/...

# Runtime integration tests (requires live credentials + market hours)
# Usage: just test-int TestBinance_
test-int filter="TestBinance_":
    go test -v -count=1 -run "{{filter}}" \
        ./internal/runtime/ -timeout 120s

# Format source files
fmt:
    gofmt -w $(rg --files cmd internal | rg '\.go$')

# ── Swagger ───────────────────────────────────────────────────────────────────

# Regenerate swagger docs
swagger:
    go run github.com/swaggo/swag/cmd/swag@v1.16.4 init \
        -g cmd/helm/swagger.go -o docs \
        --parseInternal --parseDependency --parseDepth 3

# Verify committed swagger docs are up to date
swagger-check:
    just swagger
    git diff --exit-code docs/docs.go docs/swagger.json docs/swagger.yaml

# ── Docker (deployment compose) ───────────────────────────────────────────────

# Build + start helm container
up:
    {{dc}} up -d --build helm

# Start helm without rebuild
start:
    {{dc}} up -d helm

# Stop all containers
down:
    {{dc}} down

# Tail helm logs
logs:
    {{dc}} logs -f helm

# Restart helm
restart:
    {{dc}} restart helm
