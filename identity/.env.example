# =============================================================================
# Identity Service — local dev env
# Copy this file: cp .env.example .env  (this IS the example, edit as needed)
#
# Usage:
#   docker compose up -d                  (from identity/ dir)
#   # or from repo root:
#   docker compose -f identity/docker-compose.yml --env-file identity/.env up -d
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
GIN_MODE=debug
SERVER_PORT=8082

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=mallow-dev
POSTGRES_URL=postgres://mallow:mallow-dev@localhost:5432/identity?sslmode=disable
NATS_URL=nats://identity:identity-dev@localhost:4222

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-super-secret-change-in-production
JWT_KEY_ID=identity-ed25519-local-dev
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\   \n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\    \n-----END PUBLIC KEY-----
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h

# ── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080

# ── Encryption (AES-256 — exactly 32 ASCII chars) ────────────────────────────
# Leave empty to disable field-level encryption
ENCRYPTION_KEY=secret

# ── Internal service-to-service auth ─────────────────────────────────────────
SERVICE_SECRET=dev-service-secret

# ── SMTP (leave empty — email jobs will be published to NATS but not sent) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="Identity Service"

# ── Mail worker ───────────────────────────────────────────────────────────────
MAIL_NATS_SUBJECT=mail.send
MAIL_WORKER_CONCURRENCY=3
MAIL_WORKER_BUFFER=100

# ── Telegram bot (optional) ───────────────────────────────────────────────────
TELEGRAM_GENERAL_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=thsident_bot
TELEGRAM_ALLOWED_CHATS=

# ── Admin seed (auto-creates first admin on startup if both are set) ──────────
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=Admin@123456
