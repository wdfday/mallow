dc := "docker compose -f ../deployment/docker-compose.yml"

# List all recipes
default:
    @just --list

# ── Local dev ─────────────────────────────────────────────────────────────────

# Build binary
build:
    go build -o bin/investment ./cmd/investment/

# Run locally
run:
    go run ./cmd/investment/

# Hot-reload with air
dev:
    ~/.go/bin/air

# Run tests
test:
    go test ./...

# Format source files
fmt:
    gofmt -w $(rg --files cmd internal | rg '\.go$')

# ── Swagger ───────────────────────────────────────────────────────────────────

# Regenerate swagger docs
swagger:
    go run github.com/swaggo/swag/cmd/swag@v1.8.12 init \
        -g cmd/investment/swagger.go -o docs \
        --parseInternal --parseDependency --parseDepth 3

# Verify committed swagger docs are up to date
swagger-check:
    just swagger
    git diff --exit-code docs/docs.go docs/swagger.json docs/swagger.yaml

# ── Docker (deployment compose) ───────────────────────────────────────────────

# Build + start investment container
up:
    {{dc}} up -d --build investment

# Start investment without rebuild
start:
    {{dc}} up -d investment

# Stop all containers
down:
    {{dc}} down

# Tail investment logs
logs:
    {{dc}} logs -f investment

# Restart investment
restart:
    {{dc}} restart investment
